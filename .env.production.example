# Express backend (Vercel Functions or a Node.js web service)
NODE_ENV=production
# Managed platforms normally provide PORT automatically. It is used by
# long-running Node hosts such as Koyeb and ignored by Vercel Functions.
PORT=3000
TRUST_PROXY=true

# Supabase server credentials. Never expose the service key to Vite/Vercel.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Exact comma-separated Vercel origins, with no trailing slash or path.
CORS_ORIGIN=https://jobs.example.com,https://admin.jobs.example.com

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

PASSWORD_RESET_REDIRECT_URL=https://jobs.example.com/reset-password
EMAIL_VERIFICATION_REDIRECT_URL=https://jobs.example.com/login

# Required for refresh cookies sent between separate frontend/backend origins.
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
